# Copy this file to .env and fill in real values for your environment.
# Do not commit a real .env file - this file must only ever contain
# placeholders. Variable names match app/core/config.py (Settings).

APP_ENV=development

API_TITLE=Adaptive Procurement Scheduling API
API_VERSION=1.0.0
API_PREFIX=/api

# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adaptive_procurement

# redis://<host>:<port>/<db>
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication (JWT) --------------------------------------------
# MUST be overridden with a strong, unique, secret value in any real
# deployment. The application refuses to start with this placeholder
# when APP_ENV=production (see app/core/config.py). Generate one with,
# e.g., `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
JWT_SECRET_KEY=insecure-development-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
